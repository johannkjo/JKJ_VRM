# Gagnagrunnur (SQLite til að byrja; hægt að skipta í PostgreSQL)
DATABASE_URL="file:./crm.db"

# Leynilykill fyrir innskráningarlotur – búðu til með: openssl rand -base64 32
AUTH_SECRET="breyttu-mer-i-langan-handahofskenndan-streng"

# Fyrsti stjórnandi (búinn til af `npm run setup`)
ADMIN_EMAIL="johannjo@gmail.com"
ADMIN_PASSWORD="breyttu-mer"
ADMIN_NAME="Jóhann"

# Claude (valkvætt) – fyrir sjálfvirkar eignalýsingar
ANTHROPIC_API_KEY=""

# Slóð kerfisins (notað í tenglum og fyrir Microsoft-innskráningu)
APP_URL="http://localhost:3000"

# Microsoft 365 / Outlook (valkvætt) – sjá README
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_TENANT_ID=""   # tómt = "organizations" (allir vinnureikningar)

# auglýsing.app (valkvætt)
AUGLYSING_API_URL=""
AUGLYSING_API_KEY=""

# Geymsla fyrir myndir og skjöl
UPLOAD_DIR="./uploads"
